 Recorremos i en [0, C) y j en [0, F).
*/
void mostrarTranspuesta(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == C) return;                              // CASO BASE
    if(j == F){
        cout << "\n";
        mostrarTranspuesta(M, F, C, i + 1, 0);
        return;
    }
    cout << M[j][i] << " ";
    mostrarTranspuesta(M, F, C, i, j + 1);
}

// 42) Mayor de cada fila
int mayorFila(int M[][MAXC], int C, int i, int j = 0){
    if(j == C - 1) return M[i][j];                  // CASO BASE: último de la fila
    return max(M[i][j], mayorFila(M, C, i, j + 1));
}

void mostrarMayoresFilas(int M[][MAXC], int F, int C, int i = 0){
    if(i == F) return;                              // CASO BASE
