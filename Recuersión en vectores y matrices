//  · MATRICES RECURSIVAS (26 - 50)
#include <bits/stdc++.h>
using namespace std;

const int MAXF = 20;
const int MAXC = 20;

// Función auxiliar: imprimir un valor repetido K veces con formato [x, x, x]
void mostrarRepetido(int valor, int k){
    if(k == 0) return;                      // CASO BASE
    cout << valor;
    if(k > 1) cout << ", ";
    mostrarRepetido(valor, k - 1);          // REDUCCIÓN
}


// 26) Cargar una matriz F×C
void cargar(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE: sin filas
    if(j == C){ cargar(M, F, C, i + 1, 0); return; }// salto de fila
    cin >> M[i][j];                                 // trabajo actual
    cargar(M, F, C, i, j + 1);                      // avanza columna
}

// 27) Mostrar una matriz respetando filas y columnas
void mostrar(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE
    if(j == C){                                     // fin de la fila
        cout << "\n";
        mostrar(M, F, C, i + 1, 0);
        return;
    }
    cout << M[i][j] << " ";
    mostrar(M, F, C, i, j + 1);                     // avanza columna
}

// 28) Sumar todos los elementos
int suma(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == F) return 0;                            // CASO BASE
    if(j == C) return suma(M, F, C, i + 1, 0);      // salto de fila
    return M[i][j] + suma(M, F, C, i, j + 1);       // suma y avanza
}

// 29) Contar pares e impares (contadores por referencia)
void contarParImpar(int M[][MAXC], int F, int C, int &pares, int &impares,
                    int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE
    if(j == C){ contarParImpar(M, F, C, pares, impares, i + 1, 0); return; }
    if(M[i][j] % 2 == 0) pares++;
    else impares++;
    contarParImpar(M, F, C, pares, impares, i, j + 1);
}

// 30) Encontrar el mayor (matriz no vacía)
/*
 Base: la última celda (F-1, C-1) es el mayor de sí misma.
 Si no: max(celda actual, mayor del resto).
*/
int mayor(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(j == C) return mayor(M, F, C, i + 1, 0);     // salto de fila
    if(i == F - 1 && j == C - 1) return M[i][j];    // CASO BASE: última celda
    return max(M[i][j], mayor(M, F, C, i, j + 1));  // COMBINA
}

// 31) Encontrar el menor y su primera posición
/*
 (fm, cm) guardan la posición del menor visto hasta ahora.
 Con '<' estricto nos quedamos con la primera aparición.
*/
void menor(int M[][MAXC], int F, int C, int &fm, int &cm, int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE
    if(j == C){ menor(M, F, C, fm, cm, i + 1, 0); return; }
    if(M[i][j] < M[fm][cm]){ fm = i; cm = j; }      // nuevo menor
    menor(M, F, C, fm, cm, i, j + 1);
}

// 32) Contar positivos, negativos y ceros
void contarSignos(int M[][MAXC], int F, int C, int &pos, int &neg, int &ceros,
                  int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE
    if(j == C){ contarSignos(M, F, C, pos, neg, ceros, i + 1, 0); return; }
    if(M[i][j] > 0) pos++;
    else if(M[i][j] < 0) neg++;
    else ceros++;
    contarSignos(M, F, C, pos, neg, ceros, i, j + 1);
}

// 33) Buscar un elemento (primera aparición recorriendo por filas)
bool buscar(int M[][MAXC], int F, int C, int x, int &f, int &c,
            int i = 0, int j = 0){
    if(i == F) return false;                        // CASO BASE: no está
    if(j == C) return buscar(M, F, C, x, f, c, i + 1, 0);
    if(M[i][j] == x){ f = i; c = j; return true; }  // encontrado: cortamos
    return buscar(M, F, C, x, f, c, i, j + 1);
}

// 34) Sumar cada fila
int sumaFila(int M[][MAXC], int C, int i, int j = 0){
    if(j == C) return 0;                            // CASO BASE: fin de la fila
    return M[i][j] + sumaFila(M, C, i, j + 1);
}

void mostrarSumasFilas(int M[][MAXC], int F, int C, int i = 0){
    if(i == F) return;                              // CASO BASE
    cout << "Fila " << i << ": " << sumaFila(M, C, i) << "\n";
    mostrarSumasFilas(M, F, C, i + 1);              // siguiente fila
}

// 35) Sumar cada columna
int sumaColumna(int M[][MAXC], int F, int j, int i = 0){
