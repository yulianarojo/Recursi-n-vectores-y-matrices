
// · VECTORES RECURSIVOS (01 - 25)
#include <bits/stdc++.h>
using namespace std;

const int MAX = 100;

// Función auxiliar: mostrar el vector con formato [a, b, c]
void mostrarLista(int v[], int n, int i = 0){
    if(i == n) return;                      // CASO BASE
    cout << v[i];
    if(i < n - 1) cout << ", ";             // coma entre elementos
    mostrarLista(v, n, i + 1);              // AVANZA
}

void mostrarCorchetes(int v[], int n){
    cout << "[";
    mostrarLista(v, n);
    cout << "]";
}

// Auxiliar: mostrar el rango v[ini..fin] con formato [a, b, c]
void mostrarRango(int v[], int ini, int fin){
    if(ini > fin) return;                   // CASO BASE
    cout << v[ini];
    if(ini < fin) cout << ", ";
    mostrarRango(v, ini + 1, fin);          // AVANZA
}

// 01) Cargar un vector
/*
 Si i==n ya cargamos todo (caso base).
 Si no, leemos v[i] y llamamos con i+1.
*/
void cargar(int v[], int n, int i = 0){
    if(i == n) return;                      // CASO BASE
    cin >> v[i];                            // trabajo actual
    cargar(v, n, i + 1);                    // PROGRESO
}

// 02) Mostrar un vector (del primero al último)
void mostrar(int v[], int n, int i = 0){
    if(i == n) return;                      // CASO BASE
    cout << v[i] << " ";                    // imprime ANTES de llamar
    mostrar(v, n, i + 1);                   // AVANZA
}

// 03) Mostrar en orden inverso (sin modificar el array)
/*
 Imprimimos DESPUÉS de la llamada: al desapilar
 salen del último al primero.
*/
void mostrarInverso(int v[], int n, int i = 0){
    if(i == n) return;                      // CASO BASE
    mostrarInverso(v, n, i + 1);            // primero baja hasta el final
    cout << v[i] << " ";                    // imprime al volver
}

// 04) Sumar elementos
/*
 suma(i) = v[i] + suma(i+1), con suma(n) = 0
*/
int suma(int v[], int n, int i = 0){
    if(i == n) return 0;                    // CASO BASE
    return v[i] + suma(v, n, i + 1);        // SUMA Y AVANZA
}

// 05) Contar números pares
int contarPares(int v[], int n, int i = 0){
    if(i == n) return 0;                    // CASO BASE
    return (v[i] % 2 == 0) + contarPares(v, n, i + 1);  // 1 si es par
}

// 06) Contar positivos, negativos y ceros
/*
 Los contadores se pasan por referencia y se van
 incrementando en cada llamada.
*/
void contarSignos(int v[], int n, int &pos, int &neg, int &ceros, int i = 0){
    if(i == n) return;                      // CASO BASE
    if(v[i] > 0) pos++;
    else if(v[i] < 0) neg++;
    else ceros++;
    contarSignos(v, n, pos, neg, ceros, i + 1);  // AVANZA
}

// 07) Calcular el promedio (N > 0) usando la suma recursiva (ej. 04)
double promedio(int v[], int n){
    return (double)suma(v, n) / n;
}

// 08) Contar múltiplos de K (K != 0)
int contarMultiplos(int v[], int n, int k, int i = 0){
    if(i == n) return 0;                    // CASO BASE
    return (v[i] % k == 0) + contarMultiplos(v, n, k, i + 1);
}


// 09) Encontrar el mayor (N > 0, sin variables globales)
/*
 Compara la cabeza con el máximo del resto.
 Base: el último elemento es el máximo de sí mismo.
*/
int mayor(int v[], int n, int i = 0){
    if(i == n - 1) return v[i];             // CASO BASE: último
    int m = mayor(v, n, i + 1);             // máximo de la "cola"
    return max(v[i], m);                    // COMBINA
}

// 10) Encontrar el menor y su posición (primera aparición)
/*
 Devuelve la POSICIÓN del menor desde i hasta el final.
 Usamos <= para quedarnos con la primera aparición.
*/
int posMenor(int v[], int n, int i = 0){
    if(i == n - 1) return i;                // CASO BASE
    int p = posMenor(v, n, i + 1);          // posición del menor del resto
    if(v[i] <= v[p]) return i;              // COMBINA (empate → el de la izquierda)
    return p;
}

// 11) Buscar un elemento (primera posición o -1)
int buscar(int v[], int n, int x, int i = 0){
    if(i == n) return -1;                   // CASO BASE: no se encontró
    if(v[i] == x) return i;                 // encontrado: cortamos aquí
    return buscar(v, n, x, i + 1);          // AVANZA
}

// 12) Contar repeticiones de X
int contarX(int v[], int n, int x, int i = 0){
    if(i == n) return 0;                    // CASO BASE
    return (v[i] == x) + contarX(v, n, x, i + 1);
}

// 13) Reemplazar todas las apariciones de X por Y
void reemplazar(int v[], int n, int x, int y, int i = 0){
    if(i == n) return;                      // CASO BASE
    if(v[i] == x) v[i] = y;                 // trabajo local
    reemplazar(v, n, x, y, i + 1);          // AVANZA
}

// 14) Invertir el vector en el mismo espacio (dos punteros)
void invertir(int v[], int l, int r){
    if(l >= r) return;                      // CASO BASE: punteros se cruzan
    swap(v[l], v[r]);                       // intercambio local
    invertir(v, l + 1, r - 1);              // REDUCCIÓN
}

// 15) Verificar orden ascendente (permite empates)
bool estaOrdenado(int v[], int n, int i = 0){
    if(i >= n - 1) return true;             // CASO BASE: 0 o 1 elemento restante
    if(v[i] > v[i + 1]) return false;       // FALLO TEMPRANO
    return estaOrdenado(v, n, i + 1);       // AVANZA
}

// 16) Sumar posiciones pares e impares
/*
 Avanzamos de 2 en 2: empezando en 0 sumamos índices pares,
 empezando en 1 sumamos índices impares.
*/
int sumaSaltando(int v[], int n, int i){
    if(i >= n) return 0;                    // CASO BASE
    return v[i] + sumaSaltando(v, n, i + 2);// SALTA 2 POSICIONES
}

// 17) Eliminar un elemento por posición P
/*
 Desplazamos a la izquierda desde P: v[i] = v[i+1].
 Al final el tamaño lógico disminuye en 1.
*/
void desplazarIzquierda(int v[], int n, int i){
    if(i >= n - 1) return;                  // CASO BASE: último elemento
    v[i] = v[i + 1];                        // mueve el siguiente a la izquierda
    desplazarIzquierda(v, n, i + 1);        // AVANZA
}

void eliminarPos(int v[], int &n, int p){
    if(p < 0 || p >= n) return;             // posición inválida
    desplazarIzquierda(v, n, p);
    n--;                                    // tamaño lógico
}

// 18) Ordenamiento por selección recursivo
/*
 En cada paso buscamos (recursivamente, ej. 10) el menor
 desde i, lo ponemos en v[i] y ordenamos el resto.
*/
void ordenarSeleccion(int v[], int n, int i = 0){
    if(i >= n - 1) return;                  // CASO BASE: queda 1 elemento
    int p = posMenor(v, n, i);              // mínimo recursivo del resto
    swap(v[i], v[p]);                       // lo coloca en su lugar
    ordenarSeleccion(v, n, i + 1);          // REDUCCIÓN
}

// 19) Búsqueda binaria recursiva (vector ordenado)
/*
 Divide y vencerás: miramos el medio y descartamos la mitad.
*/
int busquedaBinaria(int v[], int l, int r, int x){
    if(l > r) return -1;                    // CASO BASE: no está
    int m = (l + r) / 2;
    if(v[m] == x) return m;                 // encontrado
    if(x < v[m]) return busquedaBinaria(v, l, m - 1, x);  // mitad izquierda
    return busquedaBinaria(v, m + 1, r, x);               // mitad derecha
}

// 20) Eliminar elementos duplicados (conserva la primera aparición)
/*
 existe: ¿x ya está en v[0..k-1]?
 compactar: k es el nuevo tamaño lógico; si v[i] no estaba,
            lo copiamos a v[k] y k crece.
*/
bool existe(int v[], int k, int x, int j = 0){
    if(j == k) return false;                // CASO BASE
    return v[j] == x || existe(v, k, x, j + 1);   // CORTOCIRCUITO
}

void compactar(int v[], int n, int &k, int i = 0){
    if(i == n) return;                      // CASO BASE
    if(!existe(v, k, v[i])){                // primera aparición
        v[k] = v[i];
        k++;
    }
    compactar(v, n, k, i + 1);              // AVANZA
}

void eliminarDuplicados(int v[], int &n){
    int k = 0;
    compactar(v, n, k);
    n = k;
}

// 21) Separar pares e impares (pares primero) con intercambios
/*
 Dos punteros: l busca un impar desde la izquierda,
 r busca un par desde la derecha; cuando ambos lo
 encuentran, se intercambian.
*/
void separarParesImpares(int v[], int l, int r){
    if(l >= r) return;                              // CASO BASE
    if(v[l] % 2 == 0) separarParesImpares(v, l + 1, r);       // ya está bien
    else if(v[r] % 2 != 0) separarParesImpares(v, l, r - 1);  // ya está bien
    else{
        swap(v[l], v[r]);                           // impar ↔ par
        separarParesImpares(v, l + 1, r - 1);
    }
}

// 22) Rotación circular K posiciones a la derecha (sin auxiliar)
/*
 Truco de las 3 inversiones (usa invertir del ej. 14):
 1) invertir todo  2) invertir los primeros K  3) invertir el resto
*/
void rotarDerecha(int v[], int n, int k){
    k = k % n;                              // K mayor que N da vueltas completas
    if(k == 0) return;
    invertir(v, 0, n - 1);
    invertir(v, 0, k - 1);
    invertir(v, k, n - 1);
}

// 23) Subsecuencia contigua estrictamente creciente más larga
/*
 Llevamos el tramo actual (longitud e inicio) y el mejor.
 Si v[i] > v[i-1] el tramo crece; si no, empieza uno nuevo en i.
*/
int masLargaCreciente(int v[], int n, int i, int actual, int iniActual,
                      int mejor, int &iniMejor){
    if(i == n) return mejor;                        // CASO BASE
    if(v[i] > v[i - 1]) actual++;                   // sigue creciendo
    else{ actual = 1; iniActual = i; }              // se corta: nuevo tramo
    if(actual > mejor){ mejor = actual; iniMejor = iniActual; }
    return masLargaCreciente(v, n, i + 1, actual, iniActual, mejor, iniMejor);
}

// 24) Segundo mayor distinto
/*
 Devuelve el mayor valor que sea MENOR que el máximo.
 INT_MIN significa "no existe".
*/
int segundoMayor(int v[], int n, int maximo, int i = 0){
    if(i == n) return INT_MIN;                      // CASO BASE
    int resto = segundoMayor(v, n, maximo, i + 1);  // candidato del resto
    if(v[i] < maximo && v[i] > resto) return v[i];  // COMBINA
    return resto;
}

// 25) Máxima suma de segmento consecutivo (Kadane recursivo)
/*
 actual = mejor suma de un segmento que TERMINA en i.
 Si conviene empezar de nuevo en v[i], lo hacemos.
*/
int sumaMaxima(int v[], int n, int i, int actual, int iniActual,
               int mejor, int &ini, int &fin){
    if(i == n) return mejor;                        // CASO BASE
    if(actual + v[i] < v[i]){ actual = v[i]; iniActual = i; }  // reinicia
    else actual += v[i];                                        // extiende
    if(actual > mejor){ mejor = actual; ini = iniActual; fin = i; }
    return sumaMaxima(v, n, i + 1, actual, iniActual, mejor, ini, fin);
}

