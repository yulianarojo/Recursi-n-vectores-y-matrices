// 36) Diagonal principal: M[i][i]
int diagonalPrincipal(int M[][MAXC], int N, int i = 0){
    if(i == N) return 0;                            // CASO BASE
    return M[i][i] + diagonalPrincipal(M, N, i + 1);
}

// 37) Diagonal secundaria: M[i][N-1-i]
int diagonalSecundaria(int M[][MAXC], int N, int i = 0){
    if(i == N) return 0;                            // CASO BASE
    return M[i][N - 1 - i] + diagonalSecundaria(M, N, i + 1);
}

// 38) Sumar encima (i<j) y debajo (i>j) de la diagonal principal
void sumaEncimaDebajo(int M[][MAXC], int N, int &encima, int &debajo,
                      int i = 0, int j = 0){
    if(i == N) return;                              // CASO BASE
    if(j == N){ sumaEncimaDebajo(M, N, encima, debajo, i + 1, 0); return; }
    if(i < j) encima += M[i][j];
    else if(i > j) debajo += M[i][j];               // la diagonal no se suma
    sumaEncimaDebajo(M, N, encima, debajo, i, j + 1);
}

// 39) Mostrar el borde (en orden por filas)
/*
 Una celda es del borde si está en la primera/última fila
 o en la primera/última columna.
*/
bool esBorde(int F, int C, int i, int j){
    return i == 0 || i == F - 1 || j == 0 || j == C - 1;
}

void mostrarBorde(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE
    if(j == C){ mostrarBorde(M, F, C, i + 1, 0); return; }
    if(esBorde(F, C, i, j)) cout << M[i][j] << " ";
    mostrarBorde(M, F, C, i, j + 1);
}

// 40) Sumar el borde (cada esquina se visita una sola vez)
int sumaBorde(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == F) return 0;                            // CASO BASE
    if(j == C) return sumaBorde(M, F, C, i + 1, 0);
    int actual = esBorde(F, C, i, j) ? M[i][j] : 0;
    return actual + sumaBorde(M, F, C, i, j + 1);
}

// 41) Mostrar la transpuesta sin crear otra matriz
/*
