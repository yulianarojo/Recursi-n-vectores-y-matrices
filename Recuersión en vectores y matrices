    mostrarMayoresFilas(M, F, C, i + 1);
}

// 43) Verificar matriz simétrica
/*
 Solo revisamos la parte de encima de la diagonal (j > i)
 y comparamos con su espejo M[j][i].
*/
bool esSimetrica(int M[][MAXC], int N, int i = 0, int j = 1){
    if(i == N) return true;                         // CASO BASE
    if(j >= N) return esSimetrica(M, N, i + 1, i + 2);  // siguiente fila
    if(M[i][j] != M[j][i]) return false;            // FALLO TEMPRANO
    return esSimetrica(M, N, i, j + 1);
}

// 44) Mostrar la matriz rotada 90° en sentido horario
/*
 Rotada[i][j] = M[N-1-j][i]
*/
void mostrarRotada90(int M[][MAXC], int N, int i = 0, int j = 0){
    if(i == N) return;                              // CASO BASE
    if(j == N){
        cout << "\n";
        mostrarRotada90(M, N, i + 1, 0);
        return;
    }
    cout << M[N - 1 - j][i] << " ";
    mostrarRotada90(M, N, i, j + 1);
}

// 45) Recorrido en espiral
/*
 Por capas: fila de arriba (→), columna derecha (↓),
 fila de abajo (←), columna izquierda (↑);
 luego se repite con la capa interior.
*/
void filaDerecha(int M[][MAXC], int f, int j, int fin){      // →
    if(j > fin) return;
    cout << M[f][j] << " ";
    filaDerecha(M, f, j + 1, fin);
}
void columnaAbajo(int M[][MAXC], int c, int i, int fin){     // ↓
    if(i > fin) return;
    cout << M[i][c] << " ";
    columnaAbajo(M, c, i + 1, fin);
}
void filaIzquierda(int M[][MAXC], int f, int j, int fin){    // ←
    if(j < fin) return;
    cout << M[f][j] << " ";
    filaIzquierda(M, f, j - 1, fin);
}
void columnaArriba(int M[][MAXC], int c, int i, int fin){    // ↑
    if(i < fin) return;
    cout << M[i][c] << " ";
    columnaArriba(M, c, i - 1, fin);
}

void espiral(int M[][MAXC], int arriba, int abajo, int izq, int der){
    if(arriba > abajo || izq > der) return;                  // CASO BASE: sin capa
    filaDerecha(M, arriba, izq, der);                        // fila superior
    columnaAbajo(M, der, arriba + 1, abajo);                 // columna derecha
    if(arriba < abajo) filaIzquierda(M, abajo, der - 1, izq);// fila inferior
    if(izq < der) columnaArriba(M, izq, abajo - 1, arriba + 1); // columna izquierda
    espiral(M, arriba + 1, abajo - 1, izq + 1, der - 1);     // capa interior
}

// 46) Matriz triangular superior (debajo de la diagonal todo es 0)
/*
 Revisamos solo las celdas con i > j: fila i, columnas 0..i-1.
*/
bool esTriangularSuperior(int M[][MAXC], int N, int i = 1, int j = 0){
    if(i >= N) return true;                         // CASO BASE
    if(j == i) return esTriangularSuperior(M, N, i + 1, 0);  // fin de esa parte
    if(M[i][j] != 0) return false;                  // FALLO TEMPRANO
    return esTriangularSuperior(M, N, i, j + 1);
}

// 47) Sumar regiones triangulares (la diagonal va en ambas)
void sumaTriangulos(int M[][MAXC], int N, int &sup, int &inf, int i = 0, int j = 0){
    if(i == N) return;                              // CASO BASE
    if(j == N){ sumaTriangulos(M, N, sup, inf, i + 1, 0); return; }
    if(i <= j) sup += M[i][j];
    if(i >= j) inf += M[i][j];
    sumaTriangulos(M, N, sup, inf, i, j + 1);
}

// 48) Punto de silla: mínimo de su fila y máximo de su columna
int minFila(int M[][MAXC], int C, int i, int j = 0){
    if(j == C - 1) return M[i][j];                  // CASO BASE
    return min(M[i][j], minFila(M, C, i, j + 1));
}
int maxColumna(int M[][MAXC], int F, int j, int i = 0){
    if(i == F - 1) return M[i][j];                  // CASO BASE
    return max(M[i][j], maxColumna(M, F, j, i + 1));
}

void buscarPuntosSilla(int M[][MAXC], int F, int C, int &encontrados,
                       int i = 0, int j = 0){
    if(i == F) return;                              // CASO BASE
    if(j == C){ buscarPuntosSilla(M, F, C, encontrados, i + 1, 0); return; }
    if(M[i][j] == minFila(M, C, i) && M[i][j] == maxColumna(M, F, j)){
        cout << "Punto de silla: valor " << M[i][j]
             << "; fila " << i << "; columna " << j << "\n";
        encontrados++;
    }
    buscarPuntosSilla(M, F, C, encontrados, i, j + 1);
}

// 49) Buscar K elementos iguales seguidos
/*
 Desde (i,j) avanzamos en una dirección (di, dj) y verificamos
 que las K celdas existan y valgan lo mismo.
 Direcciones: horizontal →, vertical ↓, diagonal principal ↘,
              diagonal secundaria ↙.
*/
const int DI[4] = {0, 1, 1, 1};
const int DJ[4] = {1, 0, 1, -1};
const string NOMBRE[4] = {"horizontal", "vertical",
                          "diagonal principal", "diagonal secundaria"};

bool secuencia(int M[][MAXC], int F, int C, int i, int j, int di, int dj,
               int valor, int restantes){
    if(restantes == 0) return true;                 // CASO BASE: ya hay K
    if(i < 0 || i >= F || j < 0 || j >= C) return false;   // fuera de la matriz
    if(M[i][j] != valor) return false;              // se rompe la secuencia
    return secuencia(M, F, C, i + di, j + dj, di, dj, valor, restantes - 1);
}

// prueba las 4 direcciones desde (i,j); devuelve la dirección o -1
int probarDirecciones(int M[][MAXC], int F, int C, int i, int j, int k, int d = 0){
    if(d == 4) return -1;                           // CASO BASE: ninguna sirve
    if(secuencia(M, F, C, i, j, DI[d], DJ[d], M[i][j], k)) return d;
    return probarDirecciones(M, F, C, i, j, k, d + 1);
}

bool hayConsecutivos(int M[][MAXC], int F, int C, int k, int &fi, int &fj, int &dir,
                     int i = 0, int j = 0){
    if(i == F) return false;                        // CASO BASE
    if(j == C) return hayConsecutivos(M, F, C, k, fi, fj, dir, i + 1, 0);
    int d = probarDirecciones(M, F, C, i, j, k);
    if(d != -1){ fi = i; fj = j; dir = d; return true; }
    return hayConsecutivos(M, F, C, k, fi, fj, dir, i, j + 1);
}

// 50) Camino de suma máxima (solo derecha o abajo)
/*
 Desde (i,j): si llegué al destino, la suma es la celda.
 Si estoy en la última fila solo puedo ir a la derecha;
 en la última columna solo hacia abajo; si no, el mejor de los dos.
*/
int caminoMax(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    if(i == F - 1 && j == C - 1) return M[i][j];                // CASO BASE: destino
    if(i == F - 1) return M[i][j] + caminoMax(M, F, C, i, j + 1);  // solo derecha
    if(j == C - 1) return M[i][j] + caminoMax(M, F, C, i + 1, j);  // solo abajo
    return M[i][j] + max(caminoMax(M, F, C, i + 1, j),            // abajo
                         caminoMax(M, F, C, i, j + 1));           // derecha
}

// Reconstruye el camino eligiendo siempre la dirección con mayor suma
void mostrarCamino(int M[][MAXC], int F, int C, int i = 0, int j = 0){
    cout << M[i][j];
    if(i == F - 1 && j == C - 1) return;                        // CASO BASE
    cout << " -> ";
    if(i == F - 1) mostrarCamino(M, F, C, i, j + 1);
    else if(j == C - 1) mostrarCamino(M, F, C, i + 1, j);
    else if(caminoMax(M, F, C, i + 1, j) >= caminoMax(M, F, C, i, j + 1))
        mostrarCamino(M, F, C, i + 1, j);                       // abajo
    else
        mostrarCamino(M, F, C, i, j + 1);                       // derecha
}

